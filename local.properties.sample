## This file must *NOT* be checked into Version Control Systems,
# as it contains information specific to your local configuration.
#
# Location of the SDK. This is only used by Gradle.
# For customization when using a Version Control System, please read the
# header note.
# Path to Android SDK
sdk.dir=

# Location of the MSYS2. This is only used on Windows.
msys2.dir=

## Path to the keystore file
keystore.file=

## Obtain credentials to access Telegram API:
# https://core.telegram.org/api/obtaining_api_id
telegram.api_id=94575
telegram.api_hash=a3406de8d171bb422bb6ddf3bbd800e2

## Extension module to apply. One of: none, hms, google
tgx.extension=none